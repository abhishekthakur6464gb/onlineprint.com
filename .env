# ---------- server ----------
PORT=4000
NODE_ENV=development
# Jahan se frontend chalega (comma separated). * sirf local testing ke liye.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5500

# ---------- secrets (RANDOM rakho, kabhi git me commit mat karo) ----------
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_long_random_string
OTP_PEPPER=change_me_another_long_random_string

# ---------- owner login ----------
# Owner ki email fixed hai: abhishekthakur6464@gmail.com (locked in src/store.js).
# Password yahan bcrypt HASH ke roop me rehta hai — plain password kahin store nahi hota.
# Neeche wala hash "owner@srmu" ke liye hai. Password badalna ho to:
#   npm run hash -- "NayaPassword"   -> jo output aaye wahi yahan paste karo
OWNER_PASSWORD_HASH=$2a$10$KkESk8bO5OiVgRYxO6SpEOaKYItkS/rogTiA3jhJ6vxgPNDgJogwC

# ---------- shop ----------
SHOP_PHONE=918318640642

# ---------- OTP provider: console | whatsapp | msg91 | twilio ----------
# whatsapp set karne ke liye neeche WA_TOKEN, WA_PHONE_NUMBER_ID, template bharo.
OTP_PROVIDER=whatsapp

# ---------- OTP source: pool | phone | random ----------
# pool   -> Owner ke bulk-upload kiye 6-digit codes se (Owner Panel > OTP Codes Pool). Recommended.
# phone  -> OTP = number ke last 6 digits, kuch bhejta nahi (setup-free fallback).
# random -> Har baar naya cryptographically-random 6-digit code, provider se bhejta hai.
OTP_SOURCE=pool

# WhatsApp Cloud API (Meta)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_NAME=otp_verification
WA_TEMPLATE_LANG=en

# MSG91 (India SMS)
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=PRNTCP

# Twilio SMS
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
